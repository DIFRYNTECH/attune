{
  "name": "attune",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:uat": "vite --mode uat",
    "dev:prod": "vite --mode production",
    "api": "node server/index.js",
    "api:uat": "node scripts/run-server-env.mjs uat",
    "api:prod": "node scripts/run-server-env.mjs production",
    "dev:all": "concurrently -k \"npm run api\" \"npm run dev\"",
    "dev:all:uat": "concurrently -k \"npm run api:uat\" \"npm run dev:uat\"",
    "dev:all:prod": "concurrently -k \"npm run api:prod\" \"npm run dev:prod\"",
    "build": "vite build",
    "build:uat": "vite build --mode uat",
    "build:prod": "vite build --mode production",
    "cap:sync": "vite build && npx cap sync android",
    "cap:sync:uat": "node scripts/cap-sync-env.mjs uat",
    "cap:sync:prod": "node scripts/cap-sync-env.mjs production",
    "cap:open": "npx cap open android",
    "lint": "eslint .",
    "test": "node --test",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "video:studio": "remotion studio remotion/index.ts --port=3002",
    "video:still:opening": "remotion still remotion/index.ts AttuneBrandVertical remotion/renders/opening.png --frame=72 --scale=0.35",
    "video:still:middle": "remotion still remotion/index.ts AttuneBrandVertical remotion/renders/middle.png --frame=490 --scale=0.35",
    "video:still:closing": "remotion still remotion/index.ts AttuneBrandVertical remotion/renders/closing.png --frame=1054 --scale=0.35",
    "video:render": "remotion render remotion/index.ts AttuneBrandVertical remotion/renders/attune-brand-vertical.mp4"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@supabase/supabase-js": "^2.99.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "fluentui-emoji": "^1.3.0",
    "googleapis": "^171.4.0",
    "openai": "^4.89.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@remotion/cli": "^4.0.455",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "remotion": "^4.0.455",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
