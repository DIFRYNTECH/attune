# Optional AI board generation (server)
# 1) Copy this file to .env
# 2) Fill in your OpenAI API key

OPENAI_API_KEY=your key here
# Recommended small/fast model
OPENAI_MODEL=gpt-4o-mini

# Local API server port (Vite proxies /api to this)
PORT=8787

# Optional: restrict browser requests by Origin header (comma-separated).
# Non-browser clients can omit Origin; rate limiting still applies.
ALLOWED_ORIGINS=http://localhost:5173

# If running behind a reverse proxy/load balancer, set to 1 so req.ip is correct.
TRUST_PROXY=0