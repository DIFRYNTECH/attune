# Optional AI board generation (server)
# 1) Copy this file to .env
# 2) Fill in your OpenAI API key

# Public web origin for Attune (used for production auth callbacks).
# Example: https://app.attune.app
VITE_PUBLIC_APP_URL=

# Optional explicit auth callback URL. When set, this overrides
# VITE_PUBLIC_APP_URL + VITE_AUTH_CALLBACK_PATH.
# Example: https://app.attune.app/auth/callback
VITE_AUTH_REDIRECT_URL=

# Path used for the web/mobile auth callback when VITE_PUBLIC_APP_URL is set.
VITE_AUTH_CALLBACK_PATH=/auth/callback

OPENAI_API_KEY=your key here
# Recommended small/fast general model
OPENAI_MODEL=gpt-4o-mini
# Optional board-specific primary model. Falls back to OPENAI_MODEL if unset.
OPENAI_BOARD_MODEL=gpt-5.4-mini
# Optional board-specific AI fallback. Falls back to OPENAI_MODEL if unset.
OPENAI_BOARD_FALLBACK_MODEL=gpt-4o-mini

# Local API server port (Vite proxies /api to this)
PORT=8787

# Optional: restrict browser requests by Origin header (comma-separated).
# Non-browser clients can omit Origin; rate limiting still applies.
# For local dev, keep localhost. For production on Vercel, set this to your web app origin.
ALLOWED_ORIGINS=http://localhost:5173

# If running behind a reverse proxy/load balancer, set to 1 so req.ip is correct.
# On Vercel, set this to 1.
TRUST_PROXY=0

# Optional web billing via Paddle.
# `PADDLE_API_KEY` and `PADDLE_WEBHOOK_SECRET` stay server-side.
# `VITE_PADDLE_CLIENT_TOKEN` and `VITE_PADDLE_PLUS_PRICE_ID` are exposed to the browser.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PLUS_PRICE_ID=
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PLUS_PRICE_ID=
# `sandbox` for testing, `live` for production.
VITE_PADDLE_ENV=sandbox

# Optional but recommended for production/serverless AI rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required if you want AI usage tied to a signed-in Supabase user.
# The client will send its access token as Authorization: Bearer <jwt>.
# The server verifies the token against Supabase Auth.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Used to verify JWTs (optional; service role can also verify).
# If you don't want to put an anon key on the server, you can omit this.
SUPABASE_ANON_KEY=your anon key here

# Required to write ai_usage rows (table has no client insert policy by design).
SUPABASE_SERVICE_ROLE_KEY=your service role key here