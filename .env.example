# Attune environment template
#
# Recommended file strategy for a proper parallel-environment setup:
# - .env.local        -> local development only
# - .env.uat          -> shared UAT values
# - .env.production   -> shared production values
#
# Use the matching Vite mode/scripts:
# - npm run dev:uat
# - npm run build:uat
# - npm run build:prod
# - npm run api:uat
# - npm run api:prod
# - npm run dev:all:uat
# - npm run dev:all:prod

# -----------------------------------------------------------------------------
# Frontend / web / Capacitor client
# These are exposed to the browser/WebView.
# Set these differently in UAT vs production.
# -----------------------------------------------------------------------------

# Public web origin for the app.
# UAT example:  https://uat.useattune.co
# Prod example: https://app.useattune.co
VITE_PUBLIC_APP_URL=

# Optional explicit auth callback URL. When set, this overrides
# VITE_PUBLIC_APP_URL + VITE_AUTH_CALLBACK_PATH.
# UAT example:  https://uat.useattune.co/auth/callback
# Prod example: https://app.useattune.co/auth/callback
VITE_AUTH_REDIRECT_URL=

# Path used for the web/mobile auth callback when VITE_PUBLIC_APP_URL is set.
VITE_AUTH_CALLBACK_PATH=/auth/callback

# Absolute API base URL used by native builds and optional web deployments.
# UAT example:  https://uat.useattune.co
# Prod example: https://app.useattune.co
VITE_API_BASE_URL=

# Client-side Supabase project.
# These must point at the matching UAT or production Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your anon key here

# Optional web billing via Paddle.
# `sandbox` for UAT, `live` for production.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PLUS_PRICE_ID=
VITE_PADDLE_ENV=sandbox

# -----------------------------------------------------------------------------
# API / server
# These stay server-side.
# -----------------------------------------------------------------------------

# Local API server port (Vite proxies /api here in local dev)
PORT=8787

# Optional runtime label for logs and environment awareness.
# Defaults to the selected launcher target when using api:uat/api:prod.
ATTUNE_ENV=

# Optional AI board generation.
OPENAI_API_KEY=your key here
# Recommended small/fast general model
OPENAI_MODEL=gpt-4o-mini
# Optional board-specific primary model. Falls back to OPENAI_MODEL if unset.
OPENAI_BOARD_MODEL=gpt-5.4-mini
# Optional board-specific AI fallback. Falls back to OPENAI_MODEL if unset.
OPENAI_BOARD_FALLBACK_MODEL=gpt-4o-mini

# Restrict browser requests by Origin header (comma-separated).
# UAT example:  https://uat.useattune.co
# Prod example: https://app.useattune.co
ALLOWED_ORIGINS=http://localhost:5173

# If running behind a reverse proxy/load balancer, set to 1 so req.ip is correct.
TRUST_PROXY=0

# Server-side Supabase project.
# These should match the same environment as the client vars above.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Used to verify JWTs (optional; service role can also verify).
SUPABASE_ANON_KEY=your anon key here

# Required to write ai_usage rows and other admin-only server operations.
SUPABASE_SERVICE_ROLE_KEY=your service role key here

# Optional but recommended for AI rate limiting.
# Use separate Upstash instances/databases for UAT and production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Paddle web billing
# Use sandbox values in UAT and live values in production.
# -----------------------------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PLUS_PRICE_ID=

# -----------------------------------------------------------------------------
# Android app identity
# Use separate values if you want UAT and production installed side-by-side.
# Prod example: ATTUNE_APP_ID=com.attune.app / ATTUNE_APP_NAME=Attune
# UAT example:  ATTUNE_APP_ID=com.attune.app.uat / ATTUNE_APP_NAME=Attune UAT
# -----------------------------------------------------------------------------
ATTUNE_APP_ID=
ATTUNE_APP_NAME=

# Android auth callback identity.
# Prod examples:
# - ATTUNE_AUTH_SCHEME=com.attune.app
# - ATTUNE_AUTH_CUSTOM_HOST=login-callback
# - ATTUNE_AUTH_HOST=app.useattune.co
# UAT examples:
# - ATTUNE_AUTH_SCHEME=com.attune.app.uat
# - ATTUNE_AUTH_CUSTOM_HOST=login-callback
# - ATTUNE_AUTH_HOST=uat.useattune.co
ATTUNE_AUTH_SCHEME=
ATTUNE_AUTH_CUSTOM_HOST=login-callback
ATTUNE_AUTH_HOST=
ATTUNE_AUTH_PATH_PREFIX=/auth/callback

# Client-side native fallback callback used when mobile auth relies on a custom scheme.
# These should match the Android values above.
VITE_NATIVE_AUTH_SCHEME=
VITE_NATIVE_AUTH_HOST=login-callback

# -----------------------------------------------------------------------------
# Google Play billing (Android)
# If you run a true parallel mobile setup, UAT should use a different package name
# and its own test products.
# -----------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=

# Either set a single product ID or a comma-separated allow-list.
GOOGLE_PLAY_PRODUCT_ID=
GOOGLE_PLAY_ALLOWED_PRODUCT_IDS=

# Optional mapping, e.g. attune_plus_monthly:plus
GOOGLE_PLAY_PRODUCT_PLAN_MAP=

# -----------------------------------------------------------------------------
# Client-side Play Billing (Vite build-time, exposed to browser/WebView)
# -----------------------------------------------------------------------------
VITE_PLAY_BILLING_PRODUCT_ID=attune_plus_monthly
VITE_PLAY_BILLING_PACKAGE_NAME=com.attune.app

# -----------------------------------------------------------------------------
# Android release signing
# Set these locally or in CI. Do NOT commit keystores to git.
# -----------------------------------------------------------------------------
# ATTUNE_KEYSTORE_PATH=/absolute/path/to/attune-release.keystore
# ATTUNE_KEYSTORE_PASSWORD=
# ATTUNE_KEY_ALIAS=attune
# ATTUNE_KEY_PASSWORD=